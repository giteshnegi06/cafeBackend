# Neon Postgres connection string. One shared database serves every cafe
# (rows are scoped by cafe_id) — this is not a per-cafe database anymore.
DATABASE_URL=

# Signing secret for staff auth tokens (JWTs issued by POST /auth/login).
# Use a long random string; keep it identical across all instances of this
# deployment so tokens stay valid.
JWT_SECRET=

# Realtime updates (Pusher Channels — https://dashboard.pusher.com).
# Server-side secret used to publish events after DB writes:
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# "Forgot password?" emails — Gmail SMTP. Use a Google App Password, not the
# account's normal password (Google Account → Security → 2-Step Verification
# → App passwords).
SMTP_USER=
SMTP_PASS=
# Optional: friendly sender shown in the inbox. Defaults to SMTP_USER.
# SMTP_FROM=

# Optional: public site URL (the frontend's deployed URL) used in the
# emailed password-reset link.
# APP_BASE_URL=

# Local dev port for `npm run dev` / `npm run server`.
# PORT=3001
